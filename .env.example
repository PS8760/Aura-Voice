# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored; never commit real secrets.

# --- Auth.js (NextAuth) -----------------------------------------------------
# Signs session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in (optional). Leave both blank to use the demo provider only.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):    http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional local AI (Ollama) ---------------------------------------------
# The app works fully without these. Set AURA_ENABLE_LOCAL_AI=false to disable.
AURA_ENABLE_LOCAL_AI=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Embedding model for RAG retrieval. If absent, a deterministic offline
# embedder is used instead, so retrieval still works with no model at all.
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Persistence (MongoDB Atlas) --------------------------------------------
# Optional. When MONGODB_URI is blank the app uses an in-memory store, which is
# fully functional for local development and tests but resets on restart.
# Create a free M0 cluster at https://www.mongodb.com/atlas, then paste the
# "Connect your application" connection string below.
MONGODB_URI=
MONGODB_DB=aura_voice_cx

# --- Admin portal -----------------------------------------------------------
# Comma-separated allowlist of emails allowed to open /admin. When blank the
# admin portal is closed to everyone (safe default for public deployments).
ADMIN_EMAILS=

